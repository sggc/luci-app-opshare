#!/bin/sh
# opshare CGI - HTTP transport endpoint for devices without usable SSH.
#   GET  ...?t=TOKEN&a=collect[&force=1]  -> one node snapshot
#   GET  ...?t=TOKEN&a=all               -> merged snapshot (pull mode)
#   GET  ...?t=TOKEN&a=live              -> tiny counter payload (page polling)
#   GET  ...?t=TOKEN&a=traffic           -> this node's counter rows (peers)
#   GET  ...?t=TOKEN&a=sync              -> trigger one on-demand sync
#   POST ...?t=TOKEN&a=recv              -> push merged snapshot
#   POST ...?t=TOKEN&a=exchange&id=ID    -> report this node, get merged view
#
# a=exchange is what makes pairing work with NO router configuration at all.
# A downstream box behind NAT can reach its gateway, but the gateway cannot
# connect back through the downstream WAN firewall (input=REJECT by default).
# So the downstream box POSTs its own single-node snapshot here, and this
# endpoint replies with the current merged view. One outbound request carries
# data both ways: no inbound rule, no SSH key, no manual peer section.
#
# a=live and a=traffic are polled every couple of seconds by the page and by
# the hub, so they get a dedicated path with no uci call and no per-field
# subshells: the shared secret is kept in /tmp/opshare/token by the daemon.
# That is the difference between ~55 ms and ~15 ms per request.
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
QUERY="${QUERY_STRING:-}"

hdr_json() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'; }
hdr_text() { printf 'Content-Type: text/plain\r\nCache-Control: no-store\r\n\r\n'; }

# Any reader is a consumer: while somebody polls, the daemon keeps the
# precision profile. The file body is the epoch of the last request.
beat() { [ -d /tmp/opshare ] && printf '%s' "$(date +%s)" > /tmp/opshare/want 2>/dev/null; }

# ---- zero-config pairing handshake ----------------------------------------
# Unauthenticated by design: the two boxes have no shared secret yet, that is
# exactly what this call hands out. It is limited to private sources (WAN side
# can never pair) and can be disabled with `option auto_pair '0'`. Every field
# it returns is already visible on the LAN in plain HTTP, so this adds no new
# exposure - the token is what stops a *different* subnet from reading data.
case "$QUERY" in
*a=hello*)
	case "${REMOTE_ADDR:-}" in
	10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|127.*|::1) ;;
	*)
		hdr_json
		echo '{"ok":0,"reason":"private source required"}'
		exit 0
		;;
	esac
	# Remember who asked. In a dual-NAT cascade the downstream box can always
	# reach us, but we cannot reach its LAN address at all; the source address
	# of this very connection is therefore the only one known to work, and it
	# is exactly what its own discovery pass needs as a candidate.
	case "${REMOTE_ADDR:-}" in
	10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
		printf '%s %s\n' "$(date +%s)" "$REMOTE_ADDR" \
			>> /tmp/opshare/seen 2>/dev/null
		;;
	esac
	if [ "$(cat /tmp/opshare/autopair 2>/dev/null)" = "0" ]; then
		hdr_json
		echo '{"ok":0,"reason":"auto_pair disabled"}'
		exit 0
	fi
	HNAME=$(cat /proc/sys/kernel/hostname 2>/dev/null | tr -d '"\\' | cut -c1-40)
	[ -n "$HNAME" ] || HNAME=OpenWrt
	# The handshake must answer correctly even on a box that has never run
	# opshare-peer (both sides install at the same time, so neither has). The
	# identity is therefore derived here and persisted, never guessed as
	# "unknown" - two boxes reporting the same id would tie-break to nonsense.
	HID=$(cat /tmp/opshare/id 2>/dev/null)
	[ -n "$HID" ] || HID=$(sed -n 's/^MYID=//p' /etc/opshare/identity 2>/dev/null | head -1)
	if [ -z "$HID" ] || [ "$HID" = "unknown" ]; then
		_seed=
		for _d in br-lan br0 eth0; do
			[ -r "/sys/class/net/$_d/address" ] &&
				_seed=$(tr -d ':\n' < "/sys/class/net/$_d/address") && break
		done
		[ -n "$_seed" ] || _seed="$HNAME"
		HID=$(printf '%s' "$_seed" | md5sum 2>/dev/null | cut -c1-12)
		[ -n "$HID" ] || HID=$(printf '%s' "$_seed" | cksum | cut -d' ' -f1)
		mkdir -p /etc/opshare 2>/dev/null
		printf 'MYID=%s\nMYNAME=%s\n' "$HID" "$HNAME" > /etc/opshare/identity 2>/dev/null
	fi
	# Same reasoning for the CPU class: it decides who aggregates, so a wrong
	# default would make both boxes step down (or both aggregate).
	HPW=$(cat /tmp/opshare/power 2>/dev/null)
	case "$HPW" in
	''|*[!0-9]*)
		case "$(uci -q get opshare.main.power_profile 2>/dev/null)" in
		low) HPW=1 ;;
		normal) HPW=2 ;;
		*)
			HPW=2
			grep -qiE 'mt7621|mt7620|mt7628|mt7530|qca953|ar9331|rt305' \
				/proc/cpuinfo 2>/dev/null && HPW=1
			;;
		esac
		printf '%s' "$HPW" > /tmp/opshare/power 2>/dev/null
		;;
	esac
	HTOK=$(cat /tmp/opshare/token 2>/dev/null)
	HNONCE=$(printf '%s' "$QUERY" | sed -n 's/.*[&?]n=\([^&]*\).*/\1/p' | cut -c1-16)
	HMODE=$(uci -q get opshare.main.mode 2>/dev/null)
	[ -n "$HMODE" ] || HMODE=hub
	if [ "$HMODE" = "auto" ]; then
		HMODE=$(uci -q get opshare.main.auto_mode 2>/dev/null)
		[ -n "$HMODE" ] || HMODE=hub
	fi
	hdr_json
	printf '{"ok":1,"proto":1,"id":"%s","name":"%s","token":"%s","pw":%s,"mode":"%s","n":"%s","ts":%s}\n' \
		"$HID" "$HNAME" "$HTOK" "$HPW" "$HMODE" "$HNONCE" "$(date +%s)"
	exit 0
	;;
esac

# ---- hot path -------------------------------------------------------------
# Pattern match instead of parsing: this runs several times a second.
case "$QUERY" in
*a=live*|a=live*)
	if [ -r /tmp/opshare/token ]; then
		IFS= read -r CTOK < /tmp/opshare/token 2>/dev/null
		case "$QUERY" in
		*"t=$CTOK"*) ;;
		*) printf 'Status: 403 Forbidden\r\n'; hdr_text; echo forbidden; exit 0 ;;
		esac
		beat
		hdr_json
		cat /tmp/opshare/live.json 2>/dev/null || echo '{"schema":1,"ts":0,"nodes":[]}'
		exit 0
	fi
	;;
*a=traffic*|a=traffic*)
	if [ -r /tmp/opshare/token ]; then
		IFS= read -r CTOK < /tmp/opshare/token 2>/dev/null
		case "$QUERY" in
		*"t=$CTOK"*) ;;
		*) printf 'Status: 403 Forbidden\r\n'; hdr_text; echo forbidden; exit 0 ;;
		esac
		# No beat() here: a peer polling our counters is not a human looking at
		# the page. If it counted as a view, the low-power box would never leave
		# its fast profile and the whole power saving would be lost. The sample
		# below is taken on demand, which is all the peer needs.
		hdr_text
		# The daemon does not sample counters while nobody is watching on a
		# low-power box, so a stale snapshot has to be refreshed here: this
		# request IS the demand. Reading the timestamp out of the file costs one
		# builtin read instead of an extra process.
		_sts=0
		[ -s /tmp/opshare/traffic.snap ] &&
			IFS='|' read -r _1 _2 _3 _4 _5 _6 _sts _rest \
				< /tmp/opshare/traffic.snap 2>/dev/null
		case "$_sts" in ''|*[!0-9]*) _sts=0 ;; esac
		[ $(($(date +%s) - _sts)) -ge 3 ] && /usr/bin/opshare-traffic 2>/dev/null
		cat /tmp/opshare/traffic.snap 2>/dev/null
		exit 0
	fi
	;;
esac

# ---- cold path ------------------------------------------------------------
TOKEN=$(uci -q get opshare.main.token 2>/dev/null)

qget() { printf '%s' "$QUERY" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2-; }
action=$(qget a)
given=$(qget t)
force=$(qget force)
[ "$force" = "1" ] && export OP_SHARE_FORCE=1

if [ -n "$TOKEN" ] && [ "$given" != "$TOKEN" ]; then
	printf 'Status: 403 Forbidden\r\n'; hdr_text; echo 'forbidden'; exit 0
fi

beat

case "$action" in
	collect|self)
		# The node keeps a fresh snapshot on its own sharded schedule; serving
		# it here costs one `cat` instead of triggering a full collection.
		hdr_json
		if [ -s /tmp/opshare/self.json ]; then
			cat /tmp/opshare/self.json
		else
			/usr/bin/opshare-collect 2>/dev/null
		fi
		;;
	all)
		hdr_json
		if [ -s /tmp/opshare/all.json ]; then cat /tmp/opshare/all.json; else echo '{"schema":2,"updated":0,"nodes":[]}'; fi
		;;
	sync)
		hdr_text
		/usr/bin/opshare-force-sync >/dev/null 2>&1
		echo OK
		;;
	recv)
		len=${CONTENT_LENGTH:-0}
		case "$len" in ''|*[!0-9]*) len=0 ;; esac
		hdr_text
		if [ "$len" -gt 0 ] && [ "$len" -le 262144 ]; then
			head -c "$len" | /usr/bin/opshare-recv | tail -1
		else
			echo 'INVALID'
		fi
		;;
	exchange)
		RD=/tmp/opshare
		len=${CONTENT_LENGTH:-0}
		case "$len" in ''|*[!0-9]*) len=0 ;; esac
		rid=$(qget id)
		case "$rid" in
			''|*[!A-Za-z0-9_-]*) rid= ;;
		esac
		[ -n "$rid" ] || rid=$(printf '%s' "${REMOTE_ADDR:-unknown}" | tr -c 'A-Za-z0-9' '_')
		mkdir -p "$RD/reported" 2>/dev/null
		body="$RD/reported/$rid.json.$$"
		if [ "$len" -gt 0 ] && [ "$len" -le 262144 ]; then
			head -c "$len" > "$body" 2>/dev/null
			# A real single-node snapshot has both `schema` and `node`.
			# `a=recv` (a merged view) also has schema, so require `node` too.
			if [ -s "$body" ] && head -c 1 "$body" | grep -q '{' &&
				grep -q '"schema"' "$body" && grep -q '"node"' "$body"; then
				mv "$body" "$RD/reported/$rid.json"
				printf '%s|%s\n' "$(date +%s)" "${REMOTE_ADDR:-}" \
					> "$RD/reported/$rid.meta"
				# Nudge the daemon to merge now instead of waiting for the
				# next full collection cycle, so a freshly installed box shows
				# up on the hub within a second of its first report.
				: > "$RD/reported.new" 2>/dev/null
				hdr_json
				if [ -s "$RD/all.json" ]; then
					cat "$RD/all.json"
				else
					echo '{"schema":2,"updated":0,"ui":{},"aliases":[],"meta":{},"nodes":[]}'
				fi
			else
				rm -f "$body"
				hdr_json
				echo '{"ok":0,"reason":"invalid snapshot"}'
			fi
		else
			hdr_json
			echo '{"ok":0,"reason":"empty body"}'
		fi
		;;
	*)
		hdr_text
		echo 'opshare: a=collect|all|live|traffic|sync|recv|exchange'
		;;
esac

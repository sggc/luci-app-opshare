#!/bin/sh /etc/rc.common
# opshare - procd service (fallback: cron, installed by install.sh on
# pre-procd releases).
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	enabled=$(uci -q get opshare.main.enabled 2>/dev/null)
	[ "$enabled" = "1" ] || [ "$enabled" = "on" ] || [ "$enabled" = "true" ] || return 0
	[ -x /usr/bin/opshare-sync ] || return 0
	mkdir -p /tmp/opshare/cache /tmp/opshare/nodes
	procd_open_instance
	procd_set_param command /usr/bin/opshare-sync --loop
	# Run at a lower scheduling priority: even the small sharded blips must
	# never compete with interactive / network services on a 24/7 box.
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger opshare
}

reload_service() {
	restart
}
